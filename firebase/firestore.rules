rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // TODO: once the admin app has real auth, replace this with a check
    // against a custom claim (e.g. request.auth.token.admin == true) set
    // via the Admin SDK from server/ — don't hand-maintain a UID allowlist.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Clients may update their own profile fields, but NEVER coinBalance
      // directly — that only ever changes via server/'s /coins/spend route,
      // which writes with the Admin SDK and so bypasses these rules
      // entirely. This keeps a modified client from just granting itself
      // coins by writing to Firestore.
      allow create: if isOwner(uid) && !('coinBalance' in request.resource.data);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coinBalance']);
      allow delete: if false;

      match /coinLedger/{entryId} {
        // Ledger entries are written only by server/ (Admin SDK, bypasses
        // rules); clients can read their own history but never write it.
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Calculator catalog: readable by any signed-in user, writable only by
    // admins (through the admin panel).
    match /calculators/{calculatorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Custom formulas a user has built themselves.
    match /users/{uid}/customFormulas/{formulaId} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
