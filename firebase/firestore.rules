rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // TODO: once the admin app has real auth, replace this with a check
    // against a custom claim (e.g. request.auth.token.admin == true) set
    // via the Admin SDK from server/ — don't hand-maintain a UID allowlist.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Clients may update their own profile fields, but NEVER coinBalance
      // or lastEarnAt directly — both only ever change via server/'s
      // /coins/spend and /coins/earn routes, which write with the Admin
      // SDK and so bypass these rules entirely. lastEarnAt is protected for
      // the same reason as coinBalance: it's the cooldown timestamp
      // /coins/earn checks before granting a reward, so a client that could
      // reset it directly could just farm unlimited coins by rewriting its
      // own "last earned" time to the past on every request.
      allow create: if isOwner(uid) &&
        !request.resource.data.keys().hasAny(['coinBalance', 'lastEarnAt']);
      allow update: if isOwner(uid) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coinBalance', 'lastEarnAt']);
      allow delete: if false;

      match /coinLedger/{entryId} {
        // Ledger entries are written only by server/ (Admin SDK, bypasses
        // rules); clients can read their own history but never write it.
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // One entry per completed calculator run. Write-once (create only) —
      // a user's calculation history isn't something the client should be
      // able to edit after the fact.
      match /history/{entryId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      // Favorited calculators, keyed by calculator ID so "is this
      // favorited" is a single doc read/existence-check rather than a
      // query. Fully owner-managed (unlike history, which is append-only).
      match /favorites/{calculatorId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Calculator catalog: readable by any signed-in user, writable only by
    // admins (through the admin panel).
    match /calculators/{calculatorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Custom formulas a user has built themselves.
    match /users/{uid}/customFormulas/{formulaId} {
      allow read, write: if isOwner(uid);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
