# Copy to .env for local dev (never commit the real .env — see .gitignore).

PORT=3000

# Firebase service account JSON, minified to a single line.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", "...":"..."}

# Must match the "Authorization header" value configured for this webhook
# in the RevenueCat dashboard (Project settings -> Integrations -> Webhooks).
REVENUECAT_WEBHOOK_AUTH_TOKEN=change-me
