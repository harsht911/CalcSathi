{
  "calculators": [
    {
      "id": "emi",
      "name": "EMI Calculator",
      "category": "Loans",
      "coinCost": 5,
      "description": "Estimate the monthly instalment (EMI) on a loan given the principal, annual interest rate, and tenure.",
      "inputs": [
        { "key": "principal", "label": "Loan amount", "suffix": "₹", "min": 1 },
        { "key": "annualRate", "label": "Annual interest rate", "suffix": "%", "min": 0.01, "max": 100 },
        { "key": "tenureMonths", "label": "Tenure", "suffix": "months", "isInteger": true, "min": 1, "max": 480 }
      ],
      "formulaTokens": [
        "principal", "*", "(", "annualRate", "/", "1200", ")", "*",
        "(", "1", "+", "(", "annualRate", "/", "1200", ")", ")", "^", "tenureMonths",
        "/",
        "(", "(", "1", "+", "(", "annualRate", "/", "1200", ")", ")", "^", "tenureMonths", "-", "1", ")"
      ],
      "resultLabel": "Monthly EMI",
      "resultSuffix": "₹",
      "resultDecimalPlaces": 2
    },
    {
      "id": "sip",
      "name": "SIP Calculator",
      "category": "Investing",
      "coinCost": 15,
      "description": "Estimate the maturity value of a monthly SIP investment given the expected annual return and tenure.",
      "inputs": [
        { "key": "monthlyInvestment", "label": "Monthly investment", "suffix": "₹", "min": 1 },
        { "key": "expectedReturn", "label": "Expected annual return", "suffix": "%", "min": 0.01, "max": 100 },
        { "key": "tenureMonths", "label": "Tenure", "suffix": "months", "isInteger": true, "min": 1, "max": 600 }
      ],
      "formulaTokens": [
        "monthlyInvestment", "*",
        "(", "(", "(", "1", "+", "(", "expectedReturn", "/", "1200", ")", ")", "^", "tenureMonths", "-", "1", ")",
        "/", "(", "expectedReturn", "/", "1200", ")", ")",
        "*", "(", "1", "+", "(", "expectedReturn", "/", "1200", ")", ")"
      ],
      "resultLabel": "Maturity value",
      "resultSuffix": "₹",
      "resultDecimalPlaces": 2
    },
    {
      "id": "bmi",
      "name": "BMI Calculator",
      "category": "Health",
      "coinCost": 0,
      "description": "Body Mass Index from your weight and height.",
      "inputs": [
        { "key": "weightKg", "label": "Weight", "suffix": "kg", "min": 1, "max": 500 },
        { "key": "heightCm", "label": "Height", "suffix": "cm", "min": 30, "max": 300 }
      ],
      "formulaTokens": [
        "weightKg", "/", "(", "(", "heightCm", "/", "100", ")", "^", "2", ")"
      ],
      "resultLabel": "BMI",
      "resultSuffix": "",
      "resultDecimalPlaces": 1
    },
    {
      "id": "gst",
      "name": "GST Calculator",
      "category": "Tax",
      "coinCost": 50,
      "description": "Add GST to a base amount to see the final price.",
      "inputs": [
        { "key": "amount", "label": "Base amount", "suffix": "₹", "min": 0 },
        { "key": "gstRate", "label": "GST rate", "suffix": "%", "min": 0, "max": 100 }
      ],
      "formulaTokens": [
        "amount", "*", "(", "1", "+", "(", "gstRate", "/", "100", ")", ")"
      ],
      "resultLabel": "Total (incl. GST)",
      "resultSuffix": "₹",
      "resultDecimalPlaces": 2
    },
    {
      "id": "km-to-miles",
      "name": "KM to Miles Converter",
      "category": "Utilities",
      "coinCost": 0,
      "description": "Convert a distance from kilometers to miles.",
      "inputs": [
        { "key": "km", "label": "Distance", "suffix": "km", "min": 0 }
      ],
      "formulaTokens": [
        "km", "*", "0.621371"
      ],
      "resultLabel": "Distance",
      "resultSuffix": "miles",
      "resultDecimalPlaces": 2
    },
    {
      "id": "loan-eligibility",
      "name": "Loan Eligibility Calculator",
      "category": "Loans",
      "coinCost": 10,
      "description": "Estimate the maximum loan amount you could be eligible for, based on the EMI you can afford each month.",
      "inputs": [
        { "key": "affordableEmi", "label": "Affordable monthly EMI", "suffix": "₹", "min": 1 },
        { "key": "annualRate", "label": "Annual interest rate", "suffix": "%", "min": 0.01, "max": 100 },
        { "key": "tenureMonths", "label": "Tenure", "suffix": "months", "isInteger": true, "min": 1, "max": 480 }
      ],
      "formulaTokens": [
        "affordableEmi", "*",
        "(", "(", "1", "+", "(", "annualRate", "/", "1200", ")", ")", "^", "tenureMonths", "-", "1", ")",
        "/",
        "(", "(", "annualRate", "/", "1200", ")", "*", "(", "1", "+", "(", "annualRate", "/", "1200", ")", ")", "^", "tenureMonths", ")"
      ],
      "resultLabel": "Max loan amount",
      "resultSuffix": "₹",
      "resultDecimalPlaces": 2
    },
    {
      "id": "age",
      "name": "Age Calculator",
      "category": "Utilities",
      "coinCost": 0,
      "description": "Find your exact age in years, months, and days from your date of birth.",
      "inputs": [],
      "formulaTokens": [],
      "resultLabel": "Age",
      "resultSuffix": "years",
      "resultDecimalPlaces": 0
    },
    {
      "id": "cgpa",
      "name": "CGPA Calculator",
      "category": "Education",
      "coinCost": 0,
      "description": "Compute your overall CGPA from each subject's credits and grade point.",
      "inputs": [],
      "formulaTokens": [],
      "resultLabel": "CGPA",
      "resultSuffix": "/10",
      "resultDecimalPlaces": 2
    }
  ]
}
