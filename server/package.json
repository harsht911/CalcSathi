{
  "name": "calcsathi-server",
  "version": "0.1.0",
  "private": true,
  "description": "Small Node/Express service handling the server-side logic Firebase's free Spark plan can't run as Cloud Functions (RevenueCat webhooks, server-side coin-economy validation, scheduled jobs).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src test scripts",
    "seed:calculators": "node scripts/seed-calculators.js",
    "package:lambda": "bash scripts/package-lambda.sh"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "eslint": "^9.14.0"
  }
}
